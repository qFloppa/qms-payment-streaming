{
  "name": "rill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:compile": "node scripts/compile-contract.mjs",
    "test:contracts": "npm run contracts:compile && node --test --test-concurrency=1 tests/contracts.test.mjs",
    "chain": "node scripts/local-chain.mjs",
    "deploy": "npm run contracts:compile && node scripts/deploy.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/domain.test.ts tests/wallet.test.ts",
    "test:e2e": "npm run contracts:compile && playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "2.57.17"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "solc": "0.8.38",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
